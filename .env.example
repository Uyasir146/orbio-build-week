# ═══════════════════════════════════════════════════════════
# Swiss-Army Web Watcher — Environment Configuration
# ═══════════════════════════════════════════════════════════

# REQUIRED: Your Orbio key. Claim it on orbio.so or via the Orbio MCP.
# Format: sk-orbio-... (not sk-or-v1-...)
# Get it from: https://orbio.so → Dashboard → Claim Key
OPENROUTER_API_KEY=

# REQUIRED: Telegram bot token for delivery.
# Create a bot with @BotFather on Telegram, then paste the token here.
# Format: 123456789:ABCdef... 
TELEGRAM_BOT_TOKEN=

# Telegram chat ID to deliver messages to.
# Your personal chat ID with the bot (not the bot's ID).
TELEGRAM_CHAT_ID=

# ── Optional ───────────────────────────────────────────────

# LLM model (default works on free tier — zero credit burn).
# Free: nex-agi/nex-n2.5-mini:free (tested, works)
# Paid: openai/gpt-6-astra, google/gemini-3.8-flash
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# Shown on OpenRouter rankings — free marketing for your app.
APP_NAME=Swiss-Army Web Watcher
APP_URL=https://github.com/Uyasir146/orbio-build-week

# Robinhood Chain blockscout (default works out of the box).
ROBINHOOD_BLOCKSCOUT=https://robinhoodchain.blockscout.com

# Dashboard port (default: 3456).
DASHBOARD_PORT=3456